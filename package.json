{
  "name": "job-hunt",
  "version": "1.0.0",
  "private": true,
  "description": "Find remote full-stack jobs open to candidates in Ethiopia, track every application, and see where the search stalls",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H localhost",
    "build": "if [ \"$VERCEL_ENV\" = production ]; then drizzle-kit migrate; fi && next build",
    "start": "next start -H localhost",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "fetch": "node --env-file-if-exists=.env scripts/fetch-jobs.ts",
    "fetch:dry": "node --env-file-if-exists=.env scripts/fetch-jobs.ts --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import-json": "node --env-file-if-exists=.env scripts/import-json.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/functions": "^3.10.5",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.56.0",
    "next": "^16.3.3",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
