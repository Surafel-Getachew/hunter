# PostgreSQL. Locally: a database on your own server, e.g. the brew postgresql@14
# on port 5433 used for Galatea (createdb -p 5433 jobhunt).
# Production (Neon): DATABASE_URL is the *pooled* address (host contains "-pooler")
# and DATABASE_URL_UNPOOLED the direct one, used for migrations. The Vercel–Neon
# integration sets both.
DATABASE_URL=postgres://localhost:5433/jobhunt

# better-auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts can sign in (comma-separated).
ALLOWED_EMAILS=

# Vercel Cron sends this as a bearer token to /api/cron/fetch. Any long random string.
CRON_SECRET=
